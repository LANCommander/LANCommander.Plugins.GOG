<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      The LANCommander server the plugin is built for. Its packages are released together under
      the server's version. The plugin binds to these at runtime, so it only runs on servers whose
      public API is binary-compatible with this version (rc.1 changed SelectItem and Action). To
      build against an unreleased server, pack its SDK, Server.Plugins and Server.UI projects into
      a folder and pass -p:LANCommanderVersion=<version> -p:RestoreAdditionalProjectSources=<folder>.
    -->
    <LANCommanderVersion Condition="'$(LANCommanderVersion)' == ''">2.2.0-rc.1</LANCommanderVersion>
  </PropertyGroup>
  <ItemGroup Label="Host">
    <PackageVersion Include="LANCommander.SDK" Version="$(LANCommanderVersion)" />
    <PackageVersion Include="LANCommander.Server.Plugins" Version="$(LANCommanderVersion)" />
    <PackageVersion Include="LANCommander.Server.UI" Version="$(LANCommanderVersion)" />
  </ItemGroup>
  <ItemGroup Label="Runtime">
    <!-- Matches the host. The plugin ships its own copy, but there is no reason for them to differ. -->
    <PackageVersion Include="SharpCompress" Version="0.50.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.1" />
  </ItemGroup>
</Project>
