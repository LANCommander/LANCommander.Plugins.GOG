<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Reads GOG game installers without executing them, exposing their files, registry entries, and scripting as data.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LANCommander.GOG.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PowerShell shim a translated installer script runs against. -->
    <EmbeddedResource Include="Script\Emit\Shim\LANCommander.Inno.psm1" />
  </ItemGroup>

</Project>
